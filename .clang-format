# BSD/KNF-style clang-format config for xtc
#
# Approximates style(9) "Kernel Normal Form" / 4.4BSD style as much as
# clang-format can express.  Run via:
#
#     clang-format -i src/**/*.[ch] test/**/*.[ch] bench/**/*.[ch]
#
# Parses on clang-format 17 through 21.  It used to set both
# AlwaysBreakAfterDefinitionReturnType and AlwaysBreakAfterReturnType;
# the first is deprecated and does not accept AllDefinitions, so every
# clang-format from 17 to 21 rejected the whole file.  The return type on
# its own line is AlwaysBreakAfterReturnType: AllDefinitions (named
# BreakAfterReturnType from 19; the old key is still read).
#
# The tree is NOT formatted to this file and is not to be reformatted
# wholesale.  CI checks only the lines a change touches (the style job:
# git clang-format --diff against the merge base, clang-format 18).

BasedOnStyle: WebKit
Language: Cpp
Standard: c++03
IndentWidth: 8
TabWidth: 8
UseTab: ForIndentation
ColumnLimit: 80
ContinuationIndentWidth: 4
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignEscapedNewlines: Right
AlignOperands: true
AlignTrailingComments: true
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AlwaysBreakAfterReturnType: AllDefinitions
AlwaysBreakBeforeMultilineStrings: false
BinPackArguments: true
BinPackParameters: true
BraceWrapping:
  AfterClass: false
  AfterControlStatement: false
  AfterEnum: false
  AfterFunction: true
  AfterStruct: false
  AfterUnion: false
  BeforeCatch: false
  BeforeElse: false
  IndentBraces: false
  SplitEmptyFunction: true
BreakBeforeBinaryOperators: NonAssignment
BreakBeforeBraces: Custom
BreakBeforeTernaryOperators: false
BreakStringLiterals: false
Cpp11BracedListStyle: false
DerivePointerAlignment: false
DisableFormat: false
ForEachMacros: ['STAILQ_FOREACH', 'TAILQ_FOREACH', 'LIST_FOREACH', 'SLIST_FOREACH']
IndentCaseLabels: false
IndentPPDirectives: None
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 2
PenaltyBreakBeforeFirstCallParameter: 1000
PenaltyBreakComment: 300
PenaltyBreakFirstLessLess: 120
PenaltyBreakString: 1000
PenaltyExcessCharacter: 1000000
PenaltyReturnTypeOnItsOwnLine: 0
PointerAlignment: Right
SortIncludes: false
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesBeforeTrailingComments: 1
SpacesInCStyleCastParentheses: false
SpacesInContainerLiterals: false
SpacesInParentheses: false
SpacesInSquareBrackets: false
