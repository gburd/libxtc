.Dd May 28, 2026
.Dt XTC_REG 3
.Os
.Sh NAME
.Nm xtc_reg_create ,
.Nm xtc_reg_destroy ,
.Nm xtc_reg_register ,
.Nm xtc_reg_unregister ,
.Nm xtc_reg_lookup ,
.Nm xtc_reg_whereis ,
.Nm xtc_reg_count ,
.Nm xtc_reg_register_dup ,
.Nm xtc_reg_unregister_pid ,
.Nm xtc_reg_drop_pid ,
.Nm xtc_reg_reaper ,
.Nm xtc_reg_register_mon ,
.Nm xtc_svr_call_name ,
.Nm xtc_reg_members
.Nd named process registry
.Sh SYNOPSIS
.In xtc.h
.In xtc_reg.h
.Ft int
.Fn xtc_reg_create "xtc_reg_t **out"
.Ft void
.Fn xtc_reg_destroy "xtc_reg_t *r"
.Ft int
.Fn xtc_reg_register "xtc_reg_t *r" "const char *name" "xtc_pid_t pid"
.Ft int
.Fn xtc_reg_unregister "xtc_reg_t *r" "const char *name"
.Ft int
.Fn xtc_reg_lookup "xtc_reg_t *r" "const char *name" "xtc_pid_t *out"
.Ft int
.Fn xtc_reg_whereis "xtc_reg_t *r" "const char *name" "xtc_pid_t *out_pid"
.Ft int
.Fn xtc_reg_count "const xtc_reg_t *r"
.Ft int
.Fn xtc_reg_register_dup "xtc_reg_t *r" "const char *key" "xtc_pid_t pid"
.Ft int
.Fn xtc_reg_unregister_pid "xtc_reg_t *r" "const char *key" "xtc_pid_t pid"
.Ft int
.Fn xtc_reg_drop_pid "xtc_reg_t *r" "xtc_pid_t pid"
.Ft void
.Fn xtc_reg_reaper "void *reg"
.Ft int
.Fn xtc_reg_register_mon "xtc_reg_t *r" "const char *name" "xtc_pid_t pid"
.Ft int
.Fn xtc_svr_call_name "xtc_reg_t *r" "const char *name" "const void *req" "size_t req_size" "void **out_reply" "size_t *out_size" "int64_t timeout_ns"
.Ft int
.Fn xtc_reg_members "xtc_reg_t *r" "const char *key" "int (*fn)(xtc_pid_t, void *)" "void *user"
.Sh DESCRIPTION
.Nm xtc_reg
is a name-to-pid registry.  Modeled on Erlang's
.Sq register/2
process registration.  Lets a process find a peer by canonical
name without sharing pid pointers ahead of time.
.Pp
Names are short strings
.Pq up to 64 bytes ;
re-registering the same name with a different pid replaces the
prior binding atomically.
.Pp
xtc_app owns a registry per app
.Pq Xr xtc_app_registry 3 .
Multiple registries are permitted for sharded namespaces.
.Pp
.Fn xtc_reg_whereis
looks up the pid bound to
.Fa name ,
writing it to
.Fa out_pid
.Pq the Erlang Sq whereis No spelling of Fn xtc_reg_lookup .
.Fn xtc_reg_count
returns the number of live registrations in
.Fa r .
.Pp
.Fn xtc_reg_register_dup
registers a DUPLICATE-KEY entry: unlike
.Fn xtc_reg_register
(one pid per unique name), many pids may share one key, so a key names
a GROUP -- the substrate for pub/sub and process groups.  Registering
the same
.Pq Fa key , Fa pid
twice is idempotent.
.Fn xtc_reg_unregister_pid
removes one
.Pq Fa key , Fa pid
member (a group leave).
.Fn xtc_reg_drop_pid
removes
.Fa pid
from EVERY key it appears under (unique names and all duplicate-key
groups) and returns the number of entries removed -- the "process left
everything" cleanup an embedder calls when a process exits or a
connection closes.
.Pp
.Fn xtc_reg_reaper
is the CRASH-AWARE registry: spawn one process with this body and the
registry as its argument
.Pq Fn xtc_proc_spawn loop xtc_reg_reaper reg ... .
It registers itself, then monitors every pid registered via
.Fn xtc_reg_register_mon
and calls
.Fn xtc_reg_drop_pid
automatically when such a pid goes DOWN -- the automatic form of the
manual cleanup.  It runs until its loop is torn down.
.Fn xtc_reg_register_mon
registers
.Fa name No -> Fa pid
like
.Fn xtc_reg_register
and, when a reaper is running, arranges the entry to be auto-dropped on
the pid's DOWN; with no reaper it is exactly
.Fn xtc_reg_register .
.Pp
.Fn xtc_svr_call_name
is via-dispatch: it looks up
.Fa name No -> No pid and then Fn xtc_svr_call No it,
letting a client address a gen_server by registered name instead of
holding its pid.  It returns
.Dv XTC_E_NOTFOUND
if the name is not registered.
.Fn xtc_reg_members
visits every pid registered under
.Fa key ;
the callback runs UNDER the registry lock (keep it brief; do not
re-enter the registry), a nonzero return stops the walk, and the return
value is the number of members visited.
.Sh EXAMPLES
.Bd -literal -offset indent
xtc_reg_t *r = xtc_app_registry(app);
xtc_pid_t pid;

/* Bind a name to my process. */
xtc_reg_register(r, "metrics_proc", xtc_self());

/* From elsewhere: */
if (xtc_reg_lookup(r, "metrics_proc", &pid) == XTC_OK)
    xtc_send(pid, msg, sz);
.Ed
