.Sh NAME
.Nm xtc_reg_create ,
.Nm xtc_reg_destroy ,
.Nm xtc_reg_put ,
.Nm xtc_reg_get ,
.Nm xtc_reg_del ,
.Nm xtc_reg_visit ,
.Nm xtc_reg_members ,
.Nm xtc_reg_count ,
.Nm xtc_reg_drop_pid ,
.Nm xtc_reg_reaper ,
.Nm xtc_svr_call_name ,
