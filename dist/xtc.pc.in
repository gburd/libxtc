# dist/xtc.pc.in -- pkg-config metadata for libxtc.
#
# Copyright (c) 2026, The XTC Project
# Use of this source code is governed by the ISC License.
#
# Substituted at configure time into the build directory as xtc.pc and
# installed to $(libdir)/pkgconfig/xtc.pc by `make install`.  A sim build
# (--with-io-backend=sim) writes xtc-sim.pc for libxtc-sim.a instead.

prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: @XTC_INSTALL_NAME@
Description: High-performance async/concurrency runtime for C (@XTC_IO_BACKEND@ backend)
URL: https://codeberg.org/gregburd/libxtc
Version: @XTC_RELEASE_NAME@
Cflags: -I${includedir}
Libs: -L${libdir} -l@XTC_INSTALL_NAME@
Libs.private: @XTC_PC_LIBS_PRIVATE@
