# -------------------------------------------------------------------------
# Default goal.
# -------------------------------------------------------------------------
.PHONY: all check tests-c tests-sh tests-pbt clean distclean install uninstall compile-commands amalgamation

all: $(STATIC_LIB) $(SHARED_LIB_TARGETS) compile_commands.json

# compile_commands.json for LSP / clang-tooling.  One entry per
# library translation unit, using the exact CFLAGS/CPPFLAGS the build
# uses.  Regenerated whenever the Makefile changes.  LSPs look for it
# in the build directory; symlink it to the source root if your editor
# expects it there:  ln -sf build_unix/compile_commands.json .
compile-commands: compile_commands.json

# Single-file amalgamation (xtc.c + xtc.h), SQLite-style.  Generated
# from the tracked sources + git metadata by dist/mkamalgamation.py.
# Override the qualifier (e.g. rc1) with: make amalgamation AMALG_QUALIFIER=rc1
AMALG_QUALIFIER =
amalgamation:
	@python3 $(srcdir)/mkamalgamation.py --root $(srcdir)/.. \
		--out $(abs_builddir)/amalgamation \
		--qualifier "$(AMALG_QUALIFIER)"
compile_commands.json: Makefile
	@echo 'generating compile_commands.json'
	@printf '[\n' > $@
	@first=1; \
	for s in $(filter %.c,$(LIB_SRCS)); do \
		abs=`cd "\`dirname $$s\`" && pwd`/`basename $$s`; \
		cmd="$(CC) $(CFLAGS) $(CPPFLAGS) -c -o `basename $$s .c`.o $$abs"; \
		cmd=`printf '%s' "$$cmd" | sed -e 's/\\\\/\\\\\\\\/g' -e 's/"/\\\\"/g'`; \
		if [ $$first -eq 0 ]; then printf ',\n' >> $@; fi; first=0; \
		printf '  {"directory": "%s", "file": "%s", "command": "%s"}' \
			"$(abs_builddir)" "$$abs" "$$cmd" >> $@; \
	done; \
	printf '\n]\n' >> $@

$(STATIC_LIB): $(LIB_OBJS)
	$(AR) rcs $@ $(LIB_OBJS)
	$(RANLIB) $@

# Shared library.  All LIB_OBJS are already compiled -fPIC (see CFLAGS),
# so they can be linked into a DSO directly.  The version script limits
# the exported ABI; the SONAME carries only the SemVer major.  We build
# the fully-versioned real file (libxtc.so.X.Y.Z) and create the SONAME
# and bare-name symlinks beside it for the linker and runtime loader.
$(SHARED_LIB_REAL): $(LIB_OBJS) $(VERSION_SCRIPT)
	$(CC) -shared -fPIC \
		-Wl,-soname,$(SHARED_LIB_SONAME) \
		-Wl,--version-script=$(VERSION_SCRIPT) \
		-o $@ $(LIB_OBJS) $(LDFLAGS) $(LIBS)
	ln -sf $(SHARED_LIB_REAL) $(SHARED_LIB_SONAME)
	ln -sf $(SHARED_LIB_SONAME) $(SHARED_LIB_LINKNAME)

tls_openssl.o: $(srcdir)/../src/io/tls_openssl.c $(srcdir)/../src/inc/xtc_tls.h $(srcdir)/../src/io/tls_common.h xtc_config.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $(srcdir)/../src/io/tls_openssl.c

tls_mbedtls.o: $(srcdir)/../src/io/tls_mbedtls.c $(srcdir)/../src/inc/xtc_tls.h $(srcdir)/../src/io/tls_common.h xtc_config.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $(srcdir)/../src/io/tls_mbedtls.c

tls_gnutls.o: $(srcdir)/../src/io/tls_gnutls.c $(srcdir)/../src/inc/xtc_tls.h $(srcdir)/../src/io/tls_common.h xtc_config.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $(srcdir)/../src/io/tls_gnutls.c

tls_wolfssl.o: $(srcdir)/../src/io/tls_wolfssl.c $(srcdir)/../src/inc/xtc_tls.h $(srcdir)/../src/io/tls_common.h xtc_config.h
