# Linked -rdynamic so the test's own external-linkage chain functions
# enter the dynamic symbol table; this lets the execinfo and libunwind+
# dladdr backends resolve their names so the symbolization assertion
# fires.  On addresses-only platforms the test asserts frame count only.
test_backtrace: $(srcdir)/../test/m12/test_backtrace.c \
		$(srcdir)/../test/m12/munit.c $(STATIC_LIB)
	$(CC) $(CFLAGS) $(CPPFLAGS) -I$(srcdir)/../test/m12 \
		-o $@ $(srcdir)/../test/m12/test_backtrace.c \
		$(srcdir)/../test/m12/munit.c $(STATIC_LIB) $(LDFLAGS) -rdynamic $(LIBS)

