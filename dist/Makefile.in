tls_schannel.o: $(srcdir)/../src/io/tls_schannel.c $(srcdir)/../src/inc/xtc_tls.h xtc_config.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $(srcdir)/../src/io/tls_schannel.c

tls_none.o: $(srcdir)/../src/io/tls_none.c $(srcdir)/../src/inc/xtc_tls.h xtc_config.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $(srcdir)/../src/io/tls_none.c

# Pattern rule for compiling sources from ../src/ into ./*.o.
xtc_version.o: $(srcdir)/../src/xtc_version.c $(LIB_HDR_PUBLIC) xtc_config.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $(srcdir)/../src/xtc_version.c

xtc_strerror.o: $(srcdir)/../src/xtc_strerror.c $(LIB_HDR_PUBLIC) xtc_config.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $(srcdir)/../src/xtc_strerror.c

os_alloc.o: $(srcdir)/../src/os/os_alloc.c xtc_config.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $(srcdir)/../src/os/os_alloc.c

os_env.o: $(srcdir)/../src/os/os_env.c xtc_config.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $(srcdir)/../src/os/os_env.c

os_rand.o: $(srcdir)/../src/os/os_rand.c xtc_config.h
