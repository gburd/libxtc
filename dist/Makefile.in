# Native (real-backend) regression guard for the cross-thread wake of an
# idle io_uring / event-port loop (carrier lost-wakeup, 2026-07-06).
# Plain-main test (returns 0 pass / 1 fail / 77 skip), no munit.
repro_idle_uring_wake: $(srcdir)/../test/concurrency/repro_idle_uring_wake.c \
		$(STATIC_LIB)
	$(CC) $(CFLAGS) $(CPPFLAGS) \
		-o $@ $(srcdir)/../test/concurrency/repro_idle_uring_wake.c \
		$(STATIC_LIB) $(LDFLAGS) $(LIBS)

# xtc_proc_wake cross-thread regression guard (the PG cross-thread-latch
# wake-miss): a foreign OS thread makes an fd readable AND pokes the
# parked fiber's loop via xtc_proc_wake; the fiber must resume.
test_proc_wake_crossthread: $(srcdir)/../test/concurrency/test_proc_wake_crossthread.c \
		$(STATIC_LIB)
	$(CC) $(CFLAGS) $(CPPFLAGS) \
		-o $@ $(srcdir)/../test/concurrency/test_proc_wake_crossthread.c \
		$(STATIC_LIB) $(LDFLAGS) $(LIBS)

# Signal-mask regression guard: no runtime thread steals a process-
# directed signal (carrier SIGCHLD-to-scheduler bug).  Standalone (it
# spins an exec and can hit the documented xtc_exec_fini teardown leak,
# so it is not in the leak-checked make check set).  Returns 0/1/77.
test_thread_sigmask: $(srcdir)/../test/m1/test_thread_sigmask.c $(STATIC_LIB)
	$(CC) $(CFLAGS) $(CPPFLAGS) \
		-o $@ $(srcdir)/../test/m1/test_thread_sigmask.c \
		$(STATIC_LIB) $(LDFLAGS) $(LIBS)

