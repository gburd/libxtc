	$(srcdir)/../src/inc/xtc_exec.h \
	$(srcdir)/../src/inc/xtc_fs.h \
	$(srcdir)/../src/inc/xtc_inject.h \
	$(srcdir)/../src/inc/xtc_inspect.h \
	$(srcdir)/../src/inc/xtc_io.h \
	$(srcdir)/../src/inc/xtc_iosched.h \
	$(srcdir)/../src/inc/xtc_lockmgr.h \
	$(srcdir)/../src/inc/xtc_log.h \
	$(srcdir)/../src/inc/xtc_loop.h \
	$(srcdir)/../src/inc/xtc_lrlock.h \
	$(srcdir)/../src/inc/xtc_lwlock.h \
	$(srcdir)/../src/inc/xtc_mctx.h \
	$(srcdir)/../src/inc/xtc_net.h \
