LIB_HDR_PUBLIC	= $(srcdir)/../src/inc/xtc.h

# The full public header set installed into includedir.  xtc.h is the
# umbrella (version/error/strerror); the per-subsystem xtc_*.h headers
# carry the functional API.  All are self-contained with
# -I$(includedir) (they cross-include only each other and standard
# headers; none depends on an internal *_int.h).  Keep this in step
# with the public surface enumerated by dist/mkamalgamation.py.
LIB_HDRS_PUBLIC	= \
	$(srcdir)/../src/inc/xtc.h \
	$(srcdir)/../src/inc/xtc_runtime.h \
	$(srcdir)/../src/inc/xtc_aio.h \
	$(srcdir)/../src/inc/xtc_alloc_audit.h \
