SHARED_LIB_TARGETS_yes = $(SHARED_LIB_REAL)
SHARED_LIB_TARGETS_no  =
SHARED_LIB_TARGETS     = $(SHARED_LIB_TARGETS_$(XTC_ENABLE_SHARED))

