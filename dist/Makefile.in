# M16.1a: mock PostgreSQL backend runtime seam (examples/09_pgmock).
# Compiles the mock's listener + backend + Latch glue directly, with
# the example dir on the include path, and drives them in-process on
# an xtc_app via a raw-socket client (no libpq, so CI needs no PG).
test_pgmock_smoke: $(srcdir)/../test/m16/test_pgmock_smoke.c \
		$(srcdir)/../examples/09_pgmock/listener.c \
		$(srcdir)/../examples/09_pgmock/backend.c \
		$(srcdir)/../examples/09_pgmock/pg_latch.c $(STATIC_LIB)
	$(CC) $(CFLAGS) $(CPPFLAGS) -I$(srcdir)/../examples/09_pgmock \
		-o $@ $(srcdir)/../test/m16/test_pgmock_smoke.c \
		$(srcdir)/../examples/09_pgmock/listener.c \
		$(srcdir)/../examples/09_pgmock/backend.c \
		$(srcdir)/../examples/09_pgmock/pg_latch.c \
		$(STATIC_LIB) $(LDFLAGS) $(LIBS)

