srcdir		= @srcdir@
abs_top_srcdir	= @abs_top_srcdir@
builddir	= @builddir@
abs_builddir	= @abs_builddir@
prefix		= @prefix@
exec_prefix	= @exec_prefix@
libdir		= @libdir@
includedir	= @includedir@
mandir		= @mandir@

CC		= @CC@
# Project includes go FIRST so the in-tree headers always win over any
# system include dir (e.g. -I/usr/local/include on the BSDs, added by
# @CFLAGS@/@CPPFLAGS@ for liburing/openssl) -- otherwise a previously
# installed /usr/local/include/xtc.h would shadow the source tree and
# build against a stale API.
XTC_INCLUDES	= -I. -I$(srcdir)/../src/inc
CFLAGS		= $(XTC_INCLUDES) @CFLAGS@ -Wall -Wextra -Wpedantic -fPIC -pthread @XTC_URING_CFLAGS@ @XTC_LIBUNWIND_CFLAGS@ @XTC_TLS_CFLAGS@
CPPFLAGS	= @CPPFLAGS@ $(XTC_INCLUDES)
LDFLAGS		= @LDFLAGS@ -pthread
LIBS		= @LIBS@ @XTC_URING_LIBS@ @XTC_PLATFORM_LIBS@ @XTC_TLS_LIBS@ @XTC_LIBUNWIND_LIBS@
XTC_HEGEL_CFLAGS = @XTC_HEGEL_CFLAGS@
XTC_HEGEL_LIBS	 = @XTC_HEGEL_LIBS@
XTC_HEGEL_PBT	 = @XTC_HEGEL_PBT@
XTC_HEGEL_SERVER_COMMAND = @XTC_HEGEL_SERVER_COMMAND@
XTC_TLS_BACKEND	 = @XTC_TLS_BACKEND@
XTC_TLS_LIBS	 = @XTC_TLS_LIBS@
XTC_ENABLE_SHARED = @XTC_ENABLE_SHARED@
XTC_VERSION_FULL  = @XTC_VERSION_FULL@
XTC_VERSION_MAJOR = @XTC_VERSION_MAJOR@
AR		= ar
RANLIB		= @RANLIB@
INSTALL		= @INSTALL@
INSTALL_DATA	= @INSTALL_DATA@
INSTALL_PROGRAM	= @INSTALL_PROGRAM@
RM		= rm -f

# Shared-library knobs.  The version script (dist/libxtc.map) restricts
# the exported ABI to the public xtc_* / __xtc_* symbols and hides the
# internal __os_* layer.  SONAME carries the SemVer major only.
SHARED_LIB_LINKNAME = libxtc.so
SHARED_LIB_SONAME   = libxtc.so.$(XTC_VERSION_MAJOR)
SHARED_LIB_REAL     = libxtc.so.$(XTC_VERSION_FULL)
VERSION_SCRIPT      = $(srcdir)/libxtc.map

# -------------------------------------------------------------------------
# M0 sources.
# -------------------------------------------------------------------------
# Conditionally add the TLS backend source.  configure sets
# XTC_TLS_BACKEND to openssl|mbedtls|gnutls|wolfssl|schannel|none and
# defines exactly one XTC_TLS_BACKEND_* macro.  Exactly one
# tls_<backend>.c is compiled per build; that source provides the
# public xtc_tls_* symbols.  For --with-tls=none the NOSYS stubs in
# tls_none.c are compiled instead.
TLS_OBJS = tls_@XTC_TLS_BACKEND@.o

