# -------------------------------------------------------------------------
# Install.
# -------------------------------------------------------------------------
install: all
	$(INSTALL) -d $(DESTDIR)$(libdir)
	$(INSTALL) -d $(DESTDIR)$(libdir)/pkgconfig
	$(INSTALL) -d $(DESTDIR)$(includedir)
	$(INSTALL) -d $(DESTDIR)$(mandir)/man3
	$(INSTALL) -d $(DESTDIR)$(mandir)/man7
	$(INSTALL_DATA) $(STATIC_LIB) $(DESTDIR)$(libdir)/$(STATIC_LIB)
	for h in $(LIB_HDRS_PUBLIC); do \
		$(INSTALL_DATA) $$h $(DESTDIR)$(includedir)/; \
	done
	$(INSTALL_DATA) xtc.pc $(DESTDIR)$(libdir)/pkgconfig/xtc.pc
	@if [ "$(XTC_ENABLE_SHARED)" = yes ]; then \
		echo "installing shared library"; \
		$(INSTALL_PROGRAM) $(SHARED_LIB_REAL) \
			$(DESTDIR)$(libdir)/$(SHARED_LIB_REAL); \
		ln -sf $(SHARED_LIB_REAL) \
			$(DESTDIR)$(libdir)/$(SHARED_LIB_SONAME); \
		ln -sf $(SHARED_LIB_SONAME) \
			$(DESTDIR)$(libdir)/$(SHARED_LIB_LINKNAME); \
	fi
	for m in $(srcdir)/../man/man3/*.3; do \
		$(INSTALL_DATA) $$m $(DESTDIR)$(mandir)/man3/; \
	done
	for m in $(srcdir)/../man/man7/*.7; do \
		$(INSTALL_DATA) $$m $(DESTDIR)$(mandir)/man7/; \
	done

uninstall:
	$(RM) $(DESTDIR)$(libdir)/$(STATIC_LIB)
	$(RM) $(DESTDIR)$(libdir)/$(SHARED_LIB_REAL)
	$(RM) $(DESTDIR)$(libdir)/$(SHARED_LIB_SONAME)
	$(RM) $(DESTDIR)$(libdir)/$(SHARED_LIB_LINKNAME)
	$(RM) $(DESTDIR)$(libdir)/pkgconfig/xtc.pc
	for h in $(LIB_HDRS_PUBLIC); do \
		$(RM) $(DESTDIR)$(includedir)/`basename $$h`; \
	done

# -------------------------------------------------------------------------
# Cleanup.
# -------------------------------------------------------------------------
clean:
	$(RM) $(LIB_OBJS) $(STATIC_LIB) $(TESTS_C) $(TESTS_PBT) compile_commands.json
	$(RM) $(SHARED_LIB_REAL) $(SHARED_LIB_SONAME) $(SHARED_LIB_LINKNAME)
	rm -rf *.dSYM

distclean: clean
	$(RM) Makefile xtc_config.h xtc.pc config.log config.status
	$(RM) -r autom4te.cache
