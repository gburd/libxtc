# Build artefacts
build_unix/
build_meson/
build_*/

# Autoconf-generated files in dist/ (configure is a committed product
# in BDB tradition, but the cache and config-status helpers are not).
dist/autom4te.cache/
dist/aclocal.m4
dist/config.status
dist/config.log
dist/Makefile

# Source test script (some global Git ignores exclude every dist/ directory).
!/test/dist/
!/test/dist/test_sched_policy_build.sh

# Core dumps
core
core.*
*.core
vgcore.*

# Editor / OS detritus
*.o
*.a
*.so
*.dylib
*.dll
*.swp
.DS_Store
tags
TAGS

# macOS debug-symbol bundles (created by the Apple clang driver when it
# compiles and links an executable with -g in a single step)
*.dSYM/

# Nix
result
result-*
.direnv/
# Agent working notes -- local-only, NEVER committed (AGENTS.md rule 5).
# Do NOT `git add -f` anything under here; that override leaked 6 memos
# into Git in 2026-07 (removed in 4969eda).
.agent/
NOTES


# autoreconf backup files
dist/configure~
dist/xtc_config.h.in~
*~

# Bench compiled binaries
bench/audit/false_sharing_mpsc
bench/audit/false_sharing_proc
bench/bench_win_scale
bench/bench_msg_copy
bench/bench_tls_sendfile
bench/bench_win_scale.exe
bench/conformance/w*/tokio/target/



# Doxygen-generated documentation site
docs/api/
doxygen-warnings.txt

build_unix/test_inject_races
test/m2/test_bdev

# LSP compile database (generated)
compile_commands.json

# Generated amalgamation
/amalgamation/
build_unix/amalgamation/


# Jekyll docs build output + local bundle
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/vendor/

# Generated API-reference pages (from man pages, at docs build time)
docs/reference/api/

.envrc

# Coverage instrumentation + reports (scripts/coverage.sh, make coverage).
# gcov drops .gcov.json.gz next to wherever it is invoked, and the merged
# report tree is regenerated on every run -- none of it belongs in Git.
*.gcda
*.gcno
*.gcov
*.gcov.json.gz
coverage-out/
